[
  { "do": "wait", "sel": "#empty-add", "timeout": 30, "note": "empty state" },
  { "do": "wait", "sel": ".ready-row", "timeout": 30 },
  { "do": "sleep", "ms": 1500 },
  { "do": "shot", "file": "${SHOTS}/01-empty.png" },

  { "do": "click", "sel": "#empty-add", "note": "add a project by typing its path" },
  { "do": "click", "sel": "#context-menu [data-id=\"type-path\"]" },
  { "do": "wait", "sel": "#dialog-input" },
  { "do": "type", "sel": "#dialog-input", "text": "${GAME}" },
  { "do": "click", "sel": "#app-dialog button[value=\"ok\"]" },
  { "do": "wait", "sel": ".prefab-cell[data-key]", "timeout": 30, "note": "prefabs read" },
  { "do": "sleep", "ms": 500 },
  { "do": "shot", "file": "${SHOTS}/02-grid.png" },

  { "do": "type", "sel": "#find-input", "text": "House", "note": "find" },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Buildings/House.prefab\"]" },
  { "do": "wait", "sel": "#capture-btn" },
  { "do": "click", "sel": "#capture-btn", "note": "capture again (batch, stub Unity through WMI)" },
  { "do": "wait", "sel": "#capture-preview img", "timeout": 120 },
  { "do": "shot", "file": "${SHOTS}/03-capture.png" },

  { "do": "type", "sel": "#make-note", "text": "snow on the roof, winter mood", "note": "note and rewrite preview" },
  { "do": "click", "sel": "#rewrite-btn" },
  { "do": "wait", "sel": ".prompt-diff .prompt-change", "timeout": 60 },
  { "do": "eval", "js": "document.querySelector('.prompt-diff').scrollIntoView({ block: 'center' })" },
  { "do": "shot", "file": "${SHOTS}/04-diff.png" },

  { "do": "click", "sel": "#make-btn", "note": "make icon" },
  { "do": "wait", "sel": ".step-run", "timeout": 20 },
  { "do": "eval", "js": "document.querySelector('.stepper').scrollIntoView({ block: 'center' })" },
  { "do": "shot", "file": "${SHOTS}/05-progress.png" },
  { "do": "wait", "sel": "#result .checks-head", "timeout": 180 },
  { "do": "eval", "js": "document.querySelector('#result').scrollIntoView()" },
  { "do": "shot", "file": "${SHOTS}/06-result.png" },

  { "do": "click", "sel": "#export-btn", "note": "export" },
  { "do": "wait", "sel": ".export-done", "timeout": 30 },
  { "do": "eval", "js": "document.querySelector('.export-done').scrollIntoView({ block: 'center' })" },
  { "do": "shot", "file": "${SHOTS}/07-export.png" },

  { "do": "key", "keys": "Ctrl+2", "note": "runs tab: open the job again" },
  { "do": "wait", "sel": ".runs-list .run-item", "timeout": 20 },
  { "do": "click", "sel": ".runs-list .run-item" },
  { "do": "wait", "sel": "#result .checks-head", "timeout": 20 },
  { "do": "shot", "file": "${SHOTS}/08-runs.png" },
  { "do": "key", "keys": "Ctrl+3", "note": "styles tab" },
  { "do": "wait", "sel": ".pack-sentences li", "timeout": 20 },
  { "do": "shot", "file": "${SHOTS}/09-styles.png" },
  { "do": "key", "keys": "Ctrl+1" },

  { "do": "type", "sel": "#find-input", "text": "", "note": "two prefabs at once" },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Props/Crate.prefab\"]" },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Buildings/Tower.prefab\"]", "ctrl": true },
  { "do": "wait", "sel": "#make-btn" },
  { "do": "click", "sel": "#make-btn" },
  { "do": "wait", "sel": "#run-list .run-row", "timeout": 30 },
  { "do": "shot", "file": "${SHOTS}/10-many-progress.png" },
  { "do": "wait", "sel": "#make-btn:not([disabled])", "timeout": 300 },
  { "do": "shot", "file": "${SHOTS}/11-many-done.png" },

  { "do": "write", "file": "${BIN}/stub-scenario.txt", "text": "delay_ms=400\\ncodex=limit\\n", "note": "failure: usage limit" },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Buildings/House.prefab\"]" },
  { "do": "wait", "sel": "#make-btn:not([disabled])" },
  { "do": "click", "sel": "#make-btn" },
  { "do": "wait", "sel": ".fail-box", "timeout": 120 },
  { "do": "eval", "js": "document.querySelector('.fail-box').scrollIntoView({ block: 'center' })" },
  { "do": "shot", "file": "${SHOTS}/12-fail-limit.png" },

  { "do": "write", "file": "${BIN}/stub-scenario.txt", "text": "delay_ms=400\\nclaude=bad_json\\n", "note": "failure: the rewrite, then again with Codex" },
  { "do": "type", "sel": "#make-note", "text": "make it blue" },
  { "do": "select", "sel": "#rewriter-select", "value": "claude" },
  { "do": "click", "sel": "#make-btn" },
  { "do": "wait", "sel": ".fail-box button", "timeout": 60 },
  { "do": "eval", "js": "document.querySelector('.fail-box').scrollIntoView({ block: 'center' })" },
  { "do": "shot", "file": "${SHOTS}/13-fail-rewrite.png" },
  { "do": "write", "file": "${BIN}/stub-scenario.txt", "text": "delay_ms=400\\n" },
  { "do": "click", "sel": ".fail-box button" },
  { "do": "wait", "sel": "#result .checks-head", "timeout": 120 },

  { "do": "key", "keys": "Ctrl+,", "note": "failure: a wrong Codex path in the settings" },
  { "do": "click", "sel": "#settings-tab-generate" },
  { "do": "type", "sel": "[id=\"setting-codex.path\"]", "text": "C:\\nowhere\\codex.exe" },
  { "do": "click", "sel": "#settings-dialog button[value=\"close\"]" },
  { "do": "wait", "sel": "#banner", "timeout": 40 },
  { "do": "shot", "file": "${SHOTS}/14-banner.png" },
  { "do": "key", "keys": "Ctrl+," },
  { "do": "click", "sel": "#settings-tab-generate" },
  { "do": "type", "sel": "[id=\"setting-codex.path\"]", "text": "${BIN}\\codex.exe" },
  { "do": "click", "sel": "#settings-dialog button[value=\"close\"]" },
  { "do": "wait", "sel": "#banner", "gone": true, "timeout": 40 },

  { "do": "key", "keys": "Ctrl+Shift+D", "note": "the other theme (Ctrl+Shift+D), English" },
  { "do": "key", "keys": "Ctrl+," },
  { "do": "click", "sel": "#settings-tab-general" },
  { "do": "select", "sel": "#setting-language", "value": "en" },
  { "do": "click", "sel": "#settings-dialog button[value=\"close\"]" },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Props/Crate.prefab\"]" },
  { "do": "sleep", "ms": 800 },
  { "do": "shot", "file": "${SHOTS}/15-theme-en.png" },
  { "do": "state" }
]
