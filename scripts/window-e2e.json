  { "do": "shot", "file": "${SHOTS}/09-styles.png" },
  { "do": "key", "keys": "Ctrl+1" },
  { "do": "type", "sel": "#find-input", "text": "", "note": "two prefabs at once" },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Props/Crate.prefab\"]" },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Buildings/Tower.prefab\"]", "ctrl": true },
  { "do": "wait", "sel": "#make-btn" },
  { "do": "click", "sel": "#make-btn" },
  { "do": "wait", "sel": "#run-list .run-row", "timeout": 30 },
  { "do": "shot", "file": "${SHOTS}/10-many-progress.png" },
  { "do": "wait", "sel": "#make-btn:not([disabled])", "timeout": 300 },
  { "do": "shot", "file": "${SHOTS}/11-many-done.png" },
  { "do": "write", "file": "${BIN}/stub-scenario.txt", "text": "delay_ms=400\\ncodex=limit\\ncodex_image=copy\\n", "note": "failure: usage limit" },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Buildings/House.prefab\"]" },
  { "do": "wait", "sel": "#make-btn:not([disabled])" },
  { "do": "click", "sel": "#make-btn" },
  { "do": "wait", "sel": ".fail-box", "timeout": 120 },
  { "do": "eval", "js": "document.querySelector('.fail-box').scrollIntoView({ block: 'center' })" },
  { "do": "shot", "file": "${SHOTS}/12-fail-limit.png" },
  { "do": "write", "file": "${BIN}/stub-scenario.txt", "text": "delay_ms=400\\nclaude=bad_json\\ncodex_image=copy\\n", "note": "failure: the rewrite, then again with Codex" },
  { "do": "type", "sel": "#make-note", "text": "make it blue" },
  { "do": "select", "sel": "#rewriter-select", "value": "claude" },
  { "do": "click", "sel": "#make-btn" },
  { "do": "wait", "sel": ".fail-box button", "timeout": 60 },
  { "do": "eval", "js": "document.querySelector('.fail-box').scrollIntoView({ block: 'center' })" },
  { "do": "shot", "file": "${SHOTS}/13-fail-rewrite.png" },
  { "do": "write", "file": "${BIN}/stub-scenario.txt", "text": "delay_ms=400\\ncodex_image=copy\\n" },
  { "do": "click", "sel": ".fail-box button" },
  { "do": "wait", "sel": "#result .checks-head", "timeout": 120 },
  { "do": "write", "file": "${BIN}/stub-scenario.txt", "text": "delay_ms=400\\ncodex_image=copy_sparkle_once\\nfidelity=added_once\\n", "note": "keep the original, review by claude: a sparkle on the first picture, one retry with the correction" },
  { "do": "write", "file": "${BIN}/codex-images.count", "text": "0" },
  { "do": "write", "file": "${BIN}/claude-fidelity.count", "text": "0" },
  { "do": "write", "file": "${BIN}/codex-fidelity.count", "text": "0" },
  { "do": "key", "keys": "Ctrl+," },
  { "do": "click", "sel": "#settings-tab-generate" },
  { "do": "select", "sel": "[id=\"setting-llm.fidelityReview\"]", "value": "claude" },
  { "do": "sleep", "ms": 600 },
  { "do": "click", "sel": "#settings-dialog button[value=\"close\"]" },
  { "do": "sleep", "ms": 500 },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Buildings/House.prefab\"]" },
  { "do": "wait", "sel": "#make-note" },
  { "do": "type", "sel": "#make-note", "text": "" },
  { "do": "select", "sel": "#make-fidelity", "value": "strict" },
  { "do": "wait", "sel": "#make-btn:not([disabled])" },
  { "do": "click", "sel": "#make-btn" },
  { "do": "wait", "sel": ".step-run", "timeout": 20 },
  { "do": "wait", "sel": "#make-btn:not([disabled])", "timeout": 300 },
  { "do": "wait", "sel": "#result .fidelity-box", "timeout": 30 },
  { "do": "expect", "sel": ".fidelity-box .review-head", "text": "Claude" },
  { "do": "eval", "js": "const tabs = document.querySelectorAll('.cand-tabs [role=tab], .cand-tabs button').length; const box = document.querySelector('.fidelity-box')?.textContent ?? ''; if (tabs < 2) throw new Error('expected 2 candidates, got ' + tabs); return { tabs, box: box.slice(0, 200) }" },
  { "do": "eval", "js": "document.querySelector('#result').scrollIntoView()" },
  { "do": "shot", "file": "${SHOTS}/13b-fidelity-claude.png" },
  { "do": "write", "file": "${BIN}/stub-scenario.txt", "text": "delay_ms=400\\ncodex_image=copy_sparkle_once\\nfidelity=added_once\\n", "note": "keep the original, review by codex: a sparkle on the first picture, one retry with the correction" },
  { "do": "write", "file": "${BIN}/codex-images.count", "text": "0" },
  { "do": "write", "file": "${BIN}/claude-fidelity.count", "text": "0" },
  { "do": "write", "file": "${BIN}/codex-fidelity.count", "text": "0" },
  { "do": "key", "keys": "Ctrl+," },
  { "do": "click", "sel": "#settings-tab-generate" },
  { "do": "select", "sel": "[id=\"setting-llm.fidelityReview\"]", "value": "codex" },
  { "do": "sleep", "ms": 600 },
  { "do": "click", "sel": "#settings-dialog button[value=\"close\"]" },
  { "do": "sleep", "ms": 500 },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Buildings/House.prefab\"]" },
  { "do": "wait", "sel": "#make-note" },
  { "do": "type", "sel": "#make-note", "text": "" },
  { "do": "select", "sel": "#make-fidelity", "value": "strict" },
  { "do": "wait", "sel": "#make-btn:not([disabled])" },
  { "do": "click", "sel": "#make-btn" },
  { "do": "wait", "sel": ".step-run", "timeout": 20 },
  { "do": "wait", "sel": "#make-btn:not([disabled])", "timeout": 300 },
  { "do": "wait", "sel": "#result .fidelity-box", "timeout": 30 },
  { "do": "expect", "sel": ".fidelity-box .review-head", "text": "Codex" },
  { "do": "eval", "js": "const tabs = document.querySelectorAll('.cand-tabs [role=tab], .cand-tabs button').length; const box = document.querySelector('.fidelity-box')?.textContent ?? ''; if (tabs < 2) throw new Error('expected 2 candidates, got ' + tabs); return { tabs, box: box.slice(0, 200) }" },
  { "do": "eval", "js": "document.querySelector('#result').scrollIntoView()" },
  { "do": "shot", "file": "${SHOTS}/13c-fidelity-codex.png" },
  { "do": "write", "file": "${BIN}/stub-scenario.txt", "text": "delay_ms=400\\ncodex_image=copy\\n" },
  { "do": "key", "keys": "Ctrl+,", "note": "failure: a wrong Codex path in the settings" },
  { "do": "click", "sel": "#settings-tab-generate" },
  { "do": "type", "sel": "[id=\"setting-codex.path\"]", "text": "C:\\nowhere\\codex.exe" },
  { "do": "sleep", "ms": 600 },
  { "do": "click", "sel": "#settings-dialog button[value=\"close\"]" },
  { "do": "wait", "sel": "#banner", "timeout": 40 },
  { "do": "shot", "file": "${SHOTS}/14-banner.png" },
  { "do": "key", "keys": "Ctrl+," },
  { "do": "click", "sel": "#settings-tab-generate" },
  { "do": "type", "sel": "[id=\"setting-codex.path\"]", "text": "${BIN}\\codex.exe" },
  { "do": "sleep", "ms": 600 },
  { "do": "click", "sel": "#settings-dialog button[value=\"close\"]" },
  { "do": "wait", "sel": "#banner", "gone": true, "timeout": 40 },
  { "do": "key", "keys": "Ctrl+Shift+D", "note": "the other theme (Ctrl+Shift+D), English" },
  { "do": "key", "keys": "Ctrl+," },
  { "do": "click", "sel": "#settings-tab-general" },
  { "do": "select", "sel": "#setting-language", "value": "en" },
  { "do": "click", "sel": "#settings-dialog button[value=\"close\"]" },
  { "do": "click", "sel": ".prefab-cell[data-key=\"Assets/Props/Crate.prefab\"]" },
  { "do": "sleep", "ms": 800 },
  { "do": "shot", "file": "${SHOTS}/15-theme-en.png" },
  { "do": "state" }
]
