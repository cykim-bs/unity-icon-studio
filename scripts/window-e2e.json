  { "do": "click", "sel": ".runs-list .run-item" },
  { "do": "wait", "sel": "#result .checks-head", "timeout": 20 },
  { "do": "shot", "file": "${SHOTS}/08-runs.png" },
  { "do": "key", "keys": "Ctrl+3", "note": "styles tab" },
