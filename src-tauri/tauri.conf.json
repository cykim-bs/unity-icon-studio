{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Icon Studio",
  "mainBinaryName": "unity-icon-studio",
  "version": "0.1.0",
  "identifier": "app.unity-icon-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1441",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Icon Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "license": "../LICENSE",
    "shortDescription": "Casual game icons from Unity prefabs",
    "longDescription": "A desktop app that lists the prefabs of a Unity project, captures the chosen ones with Unity, has an image model redraw the capture in a casual icon style with a fixed prompt, and adds a thick outline and a transparent background in code.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}
